{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "displayName": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 256 },
        "photoURL": { "type": "string", "maxLength": 1024 },
        "createdAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["uid", "email"]
    },
    "Project": {
      "title": "Project",
      "description": "Circuit schematic, wiring, and firmware sketch project",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 128 },
        "desc": { "type": "string", "maxLength": 512 },
        "userId": { "type": "string", "maxLength": 128 },
        "authorName": { "type": "string", "maxLength": 128 },
        "components": { "type": "array" },
        "wires": { "type": "array" },
        "firmwareCode": { "type": "string", "maxLength": 50000 },
        "status": { "type": "string", "enum": ["Draft", "Simulating", "Completed"], "maxLength": 32 },
        "isPublic": { "type": "boolean" },
        "createdAt": { "type": "string", "maxLength": 64 },
        "updatedAt": { "type": "string", "maxLength": 64 }
      },
      "required": ["id", "name", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "Stores user account profile information"
    },
    "/projects/{projectId}": {
      "schema": "Project",
      "description": "Stores circuit projects authored by users"
    }
  }
}
